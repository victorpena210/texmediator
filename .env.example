# Acuity credentials from Acuity > Integrations > API
ACUITY_USER_ID=
ACUITY_API_KEY=

# The exact intake-form field name is enough. The numeric ID is preferred
# when available because it remains stable if the field label changes.
ACUITY_PARTY_B_EMAIL_FIELD_NAME=Party B billing email address
ACUITY_PARTY_B_EMAIL_FIELD_ID=

# Use a restricted Stripe key with only Customers, Invoices, and
# Invoice Items read/write access. Start with rk_test_ and switch to
# the matching rk_live_ key only after testing is complete.
STRIPE_RESTRICTED_KEY=

# Party B's invoice is due one day after it is sent by default.
STRIPE_INVOICE_DAYS_UNTIL_DUE=1
BILLING_CONTACT_EMAIL=hugh@texmediator.com
